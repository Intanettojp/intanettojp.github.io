---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
	xmlns:content="http://purl.org/rss/1.0/modules/content/"
	xmlns:wfw="http://wellformedweb.org/CommentAPI/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:atom="http://www.w3.org/2005/Atom"
	xmlns:sy="http://purl.org/rss/1.0/modules/syndication/"
	xmlns:slash="http://purl.org/rss/1.0/modules/slash/"
	xmlns:post-id="com-wordpress:feed-additions:1"
	>

<channel>
	<title>{{ site.title | xml_escape }}</title>
	<atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
	<link>{{ site.url }}/</link>
	<description>{{ site.description | xml_escape }}</description>
	<lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
	<language>pt-BR</language>
	<sy:updatePeriod>hourly</sy:updatePeriod>
	<sy:updateFrequency>1</sy:updateFrequency>
	<generator>https://wordpress.org/?v=7.0</generator>
	
	{% for post in site.posts limit:20 %}
	<item>
		<title>{{ post.title | xml_escape }}</title>
		<link>{{ post.url | absolute_url }}</link>
		<dc:creator><![CDATA[{{ post.author | default: site.author_name }}]]></dc:creator>
		<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
		{% for category in post.tags %}
		<category><![CDATA[{{ category | xml_escape }}]]></category>
		{% endfor %}
		<guid isPermaLink="false">{{ post.url | absolute_url }}</guid>

		<description><![CDATA[
            {% if post.image %}
            <img width="400" src="{{ post.image }}" class="webfeedsFeaturedVisual wp-post-image" style="display: block; margin: auto; margin-bottom: 5px;max-width: 100%;" />
            {% endif %}
            {{ post.content | strip_html | truncatewords: 50 }}
            <p>O post <a href="{{ post.url | absolute_url }}">{{ post.title | xml_escape }}</a> apareceu primeiro em <a href="{{ site.url }}">{{ site.title }}</a>.</p>
        ]]></description>
		<content:encoded><![CDATA[
            {% if post.image %}
            <img src="{{ post.image }}" class="webfeedsFeaturedVisual wp-post-image" style="display: block; margin: auto; margin-bottom: 5px;max-width: 100%;" />
            {% endif %}
            {{ post.content | xml_escape }}
            <p>O post <a href="{{ post.url | absolute_url }}">{{ post.title | xml_escape }}</a> apareceu primeiro em <a href="{{ site.url }}">{{ site.title }}</a>.</p>
        ]]></content:encoded>
		<post-id:post-id>{{ post.path | split: '/' | last | remove: '.md' }}</post-id:post-id>
	</item>
	{% endfor %}
</channel>
</rss>